# Normalise line endings: text files are stored with LF in the repo and
# checked out with LF on every OS (overrides core.autocrlf, so stash/checkout
# no longer rewrite LF files as CRLF on Windows).
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts must be LF or they break on Linux/Render.
*.sh   text eol=lf

# Binary files: never normalise, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.wasm  binary
*.pck   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.zip   binary
*.pdf   binary
