SUPABASE_URL=
SUPABASE_KEY=

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Defaults to the local Vite dev server if unset -- only needs to be set
# explicitly in deployed environments, to the real Cloudflare Pages URL(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base origin the frontend is served from -- QR codes encode
# <FRONTEND_BASE_URL>/scan/<code> (Hunt) and <FRONTEND_BASE_URL>/animals/<slug>
# (Our Animals). Defaults to the local Vite dev server; set to the real
# deployed frontend origin before printing park signage.
FRONTEND_BASE_URL=http://localhost:5173

# Shared staff password gating /staff (see app/staff_auth.py) -- single
# credential, no per-staff accounts (POC scope).
STAFF_PASSWORD=
# Signing secret for staff session tokens (itsdangerous). Any long random
# string; rotating it invalidates all existing staff sessions.
STAFF_SESSION_SECRET=

# Resend API key for transactional email (Guest Accounts Phase 0's password
# reset emails -- see app/services/email.py). Get this from Render's
# dashboard, never paste the raw key into chat.
RESEND_API_KEY=
# Optional -- defaults to Resend's shared testing sender (no domain
# verification needed). Set to a verified custom-domain address before this
# goes anywhere near real guest volume.
RESEND_FROM_ADDRESS=onboarding@resend.dev

# Shared secret gating POST /internal/session-cleanup (see
# app/internal_auth.py) -- the scheduled GitHub Actions workflow
# (.github/workflows/session-cleanup.yml) sends this as the X-Internal-Secret
# header. Any long random string; generate a fresh one per environment, never
# reuse the local dev value in production.
INTERNAL_CLEANUP_SECRET=

# Kill switch for the in-process reference-data cache (app/reference_cache.py:
# map nodes, bingo layout, minigames, puzzles, scoring games, Hunt content,
# announcements, animal photos, the photo gallery and QR lookup tables).
# Optional -- unset means ON. Set to 0 (or false/no/off) to turn caching off
# entirely without a code change; every request then reads Supabase directly,
# exactly as before the cache existed. See DEPLOYMENT.md section 7.
REFERENCE_CACHE_ENABLED=1

# DEV MACHINES ONLY -- never set this in Render/production. Comma-separated
# Supabase project refs (the <ref> in https://<ref>.supabase.co) that the
# dev-only scripts may run against: cleanup_dev_test_data.py,
# e2e_run_cleanup.py, reset_demo_data.py, e2e_collision_fixture.py and
# verify_session_cleanup.py (all in scripts/, guarded by
# dev_test_data.assert_dev_project). Unset, empty, or a URL whose ref isn't
# listed = they refuse before touching the database, and the e2e suite
# stops at setup.
DEV_SUPABASE_PROJECT_REFS=
